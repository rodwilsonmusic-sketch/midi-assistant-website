<SCRIPT name="setShiftValText()" script="

decl shiftListLc =  {'-OCT','-M7','-m7','-M6','-m6','-P5','-TRI','-P4','-M3','-m3','-M2','-m2','-10CEN','+10CEN','+m2','+M2','+m3','+M3','+P4','+TRI','+P5','+m6','+M6','+m7','+M7','+OCT','+OCT&5','+2 OCT'};  // 29



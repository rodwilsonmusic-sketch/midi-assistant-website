decl octave = floor(midiNote / 12) - 2; // Calculate the octave (-1 to 9)
decl noteIndex = midiNote % 12; // Get note index in the scale

if (xShiftNoteVal == 0 )
{
 topRangeNoteName = 'OFF' ;

   decl xf = 1;   
   //ctlout(0, 39, 0 , 14) ; // ctlout( midiport , CCNumber, Value, Channel);

}
else  
{
    
topRangeNoteName = noteNames[noteIndex] + octave; // Construct the note name
// ctlout(0, 39, 127 , 14) ;
  //noteout( 0, xdroneNoteVal, 100, 1) ;
//   ctlout(0, 102,xdroneNoteVal , 2) ;
}





//setattribute(DroneNoteNameText,'content',droneNoteName);
setattribute(ContainerPadOctaveSplitter.NoteNameTopRangeText,'content',topRangeNoteName);
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerPadOctaveSplitter/SetTopRangeNoteName" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="setBottomNoteRangeName()" script="
decl xShiftNoteVal = bottomRangeNote ;

decl midiNote = xShiftNoteVal ;

// Arrays for Note Names (C, C#, D, ..., B)
decl noteNames = { 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B' };


decl octave = floor(midiNote / 12) - 2; // Calculate the octave (-1 to 9)
decl noteIndex = midiNote % 12; // Get note index in the scale

if (xShiftNoteVal == 0 )
{
 bottomRangeNoteName = 'OFF' ;

   decl xf = 1;   
   //ctlout(0, 39, 0 , 14) ; // ctlout( midiport , CCNumber, Value, Channel);

}
else  
{
    
bottomRangeNoteName = noteNames[noteIndex] + octave; // Construct the note name
// ctlout(0, 39, 127 , 14) ;
  //noteout( 0, xdroneNoteVal, 100, 1) ;
//   ctlout(0, 102,xdroneNoteVal , 2) ;

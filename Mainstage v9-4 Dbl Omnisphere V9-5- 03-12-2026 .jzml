<SCRIPT name="translateDecayText1()" script="
decl xtextval = bSkyDecayText1 ;

decl ttext ;

if (xtextval <= 1000) 
{

ttext = round(xtextval)  ;
ttext = ttext & 'ms';
//setattribute(ContainerBlueSkyPad1.DecayText1,'content',ttext);
setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayMonitor2,'precision',1);
setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayMonitor2,'unit',' ms');

bSkyDecayTranText1 = ttext ;

// DecayMonitor2
}

else if (xtextval < 10000) 
{
ttext = round(xtextval)/1000  ;
ttext = ttext & 'x ';

setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayMonitor2,'precision',3);
setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayMonitor2,'unit',' s');
bSkyDecayTranText1 = ttext ;
}

else // if (xtextval < 10000) 
{
ttext = round(xtextval)/1000  ;
ttext = ttext & 'x ';

setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayMonitor2,'precision',2);
setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayMonitor2,'unit',' s');

bSkyDecayTranText1 = ttext ;
}

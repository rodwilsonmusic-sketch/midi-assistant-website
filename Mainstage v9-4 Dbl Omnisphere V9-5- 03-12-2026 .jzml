" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyElPn/ContainerBSkyBloom/translateDecayTextNew" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="calcNewDecayText()" script="
decl midiVal = bSkyBloomDecayMidiNum; 
/*

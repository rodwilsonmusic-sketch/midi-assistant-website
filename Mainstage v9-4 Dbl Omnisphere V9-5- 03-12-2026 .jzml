<SCRIPT name="calcSection1DecayText()" script="
decl knobValue = bSkyDecayKnobVal;  // ContainerBSkyShimmer.DecayKnob1.x ;
decl xtext ;

decl start ;
decl end ;
decl t ;
decl decayTime; 
decl sulfix = '' ;

if (knobValue <= 0.5 )  // 8051398  //7952756//7792455//8043170 // 8013444
{  // Begin Section 1 DecayKnob1

if (knobValue <= 0.074408) 
{
   start = 1000.00 ; 
   end =  1010.00 ;
   t = knobValue / 0.074408 ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if (knobValue <= 0.100902) 
{
   start =1010.00 ; 
   end = 1031.00 ;
   t = (knobValue - 0.074408) / (0.100902 - 0.074408 ) ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}


else if (knobValue <= 0.125981) //  3149614
{
   start = 1031.00 ; 
   end = 1061.00 ;
   t = (knobValue - 0.100902) / (0.125981 - 0.100902 ) ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}


else if  (knobValue <= 0.241323)  // Stopped here
{
   t = (knobValue - 0.125981) / (0.241323 - 0.125981); 
   start = 1061.00 ; 
   end = 1518.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.250008)   //  5275588  //527559  // 5364360
{
   t = (knobValue - 0.241323) / (0.250008 - 0.241323); 
   start = 1518.00 ; 
   end = 1574.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

//527559
//5826772

else if  (knobValue <= 0.297625) // 5832058  // 5826772 // 5911982
{
   t = (knobValue - 0.250008) / (0.297625 - 0.250008); 
   start = 1574.00 ; 
   end = 1999.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.307618)   //  6300384 // 6299213  // 6367752
{
   t = (knobValue - 0.297625) / (0.307618 - 0.297625); 
   start = 1999.00 ; 
   end = 2086.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.368263)  // 6692913 // 6704680  
{
   t = (knobValue - 0.307618) / (0.368263 - 0.307618); 
   start = 2086.00 ; 
   end = 2983.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.42612) // 7096887 // 7086614
{
   t = (knobValue -  0.368263) / (0.42612 -  0.368263); 
   start = 2983.00 ; 
   end = 4103.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.461477) // 7411927  // 7401575
{
   t = (knobValue - 0.42612) / (0.461477 - 0.42612); 
   start = 4103.00 ; 
   end = 5133.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.496028)  // 7728114  // 7716535
{
   t = (knobValue - 0.461477) / (0.496028 - 0.461477); 
   start = 5133.00 ; 
   end = 6104.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if  (knobValue <= 0.5)  // 8051398 // 7952756 // 8043170//8049910 //8041290 //8013444
{
   t = (knobValue - 0.496028) / (0.5 - 0.496028); 
   start = 6104.00 ; 
   end = 6371.00 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}





decayTime = decayTime & sulfix;

bSkyDecayText1 = decayTime ;

//setBSkyDelayText();

//setattribute(ContainerBlueSkyPad1.DecayText1,'content',bSkyDecayText1);

//ctlout(0

}  /// End of Section 1 " trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyCloud/calcSection1DecayText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="0"/>
<SCRIPT name="calcSection2DecayText()" script="
decl knobValue = bSkyDecayKnobVal;//ContainerBSkyShimmer.DecayKnob1.x ;
decl xtext ;

decl start ;
decl end ;
decl t ;
decl delayTime; 
decl sulfix = '' ;

//---- Section 2

if  (knobValue > 0.5)   //8051398 // 7792455 //8043170 // 8049910
{   // Section 2 Begins
if   (knobValue <= 0.53215)  // 8267717 // 8188977
{
   t = (knobValue - 0.5) / (0.53215 - 0.5); 
   start = 6371.00 ; 
   end = 7531.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if   (knobValue <= 0.57402)  // 8267717 // 8188977
{
   t = (knobValue - 0.53215) / (0.57402 - 0.53215); 
   start = 7531.00 ; 
   end = 9212.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if   (knobValue <= 0.626535)  
{
   t = (knobValue - 0.57402) / (0.626535 - 0.57402); 
   start = 9212.00 ; 
   end = 12030.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.696749)
{
   t = (knobValue - 0.626535) / (0.696749 - 0.626535); 
   start = 12030.00 ; 
   end = 16000.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.749459)
{
   t = (knobValue - 0.696749) / (0.749459 - 0.696749); 
   start = 16000.00 ; 
   end = 20210.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.798196) // 9126602 // 9055118
{
   t = (knobValue - 0.749459) / (0.798196 - 0.749459); 
   start = 20210.00 ; 
   end = 24400.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.824119)
{
   t = (knobValue - 0.798196) / (0.824119 - 0.798196); 
   start = 24400.00 ; 
   end = 27520.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.924141)  // 9492940 // 94488
{
   t = (knobValue - 0.824119) / (0.924141 - 0.824119); 
   start = 27520.00 ; 
   end = 38600.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.95158) //9668000 // 96006299 // 9715940
{
   t = (knobValue - 0.924141) / (0.95158- 0.924141); 
   start = 38600.00 ; 
   end = 42910.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if   (knobValue <= 0.972776)   // 9878429 //9763780 // 9858823 
{
   t = (knobValue - 0.95158) / (0.972776 - 0.95158); 
   start = 42910.00 ; 
   end = 46350.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}


else
{
    t = (knobValue - 0.972776) / (1 - 0.972776);  // -- Normalize for this segment
   start = 46350.00 ; 
   end = 50000.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

delayTime = delayTime & sulfix;

/*
function lerp(start, end, t)
    return (1 - t) * start + t * end;
end
if (knobValue <= 0.31496) then
    t = knobValue / 0.31496;  -- Normalize the knobValue to range [0, 1] for this segment
    delayTime = lerp(500, 1000, t);
elseif (knobValue <= 0.79528) then
    t = (knobValue - 0.31496) / (0.79528 - 0.31496);  -- Normalize for this segment
    delayTime = lerp(1000, 10000, t);
else
    t = (knobValue - 0.79528) / (1 - 0.79528);  -- Normalize for this segment
    delayTime = lerp(10000, 20000, t);
end
*/

bSkyDecayText1 = delayTime ;

//setBSkyDelayText();

setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayText1,'content',bSkyDecayText1);

//ctlout(0
}  // Section 2 Ends" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyCloud/calcSection2DecayText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="0"/>
<SCRIPT name="setBSkyDelayText()" script="
decl xtext = bSkyDecayText1 ;


setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayText1,'content',xtext);

//ctlout(0,70, xmidival, 16) ;  //target 0, cc, value value, channel1" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyCloud/setBSkyDelayText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="translateDecayText1()" script="
decl xtextval = bSkyDecayText1 ;


setattribute(ContainerBSkyCloud.DecayText1,'content',xtextval);
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyCloud/translateDecayText1" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="setbskyModeVal()" script="
decl xsel = firstof(ContainerBSkyShimmer.ModeSwitch2.x) ;




decl xmval ;

if (xsel == 0) 
{
xmval = 3 ;
bskySwitchMode1Num = xmval ;
}

else if (xsel == 1)
{

xmval = 63 ;
bskySwitchMode1Num = xmval ;
}

else 
{
xmval = 120 ;
bskySwitchMode1Num = xmval ;

}

bskyval1 = xmval;


//bskySwitchMode1Num = mval;

ctlout(0,76, xmval, 16) ;  //target 0, cc, value value, channel1" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyCloud/setbskyModeVal" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="calcNewDecayText()" script="




decl midiVal = round(DecayKnob1.x * 127);

bSkyCloudMidiNum = midiVal ;

// Decay Time Display Array (for Lemur)
decl DecayTextArray = {
'1000ms', '1000ms', '1000ms', '1000ms', '1.001s', '1.001s', '1.003s', '1.004s', '1.007s', '1.010s',
'1.013s', '1.018s', '1.024s', '1.031s', '1.040s', '1.050s', '1.061s', '1.075s', '1.090s', '1.107s',
'1.126s', '1.147s', '1.171s', '1.198s', '1.227s', '1.259s', '1.294s', '1.331s', '1.373s', '1.418s',
'1.466s', '1.518s', '1.574s', '1.634s', '1.698s', '1.766s', '1.839s', '1.917s', '1.999s', '2.086s',
'2.179s', '2.277s', '2.380s', '2.488s', '2.663s', '2.424s', '2.851s', '2.983s', '3.123s', '3.269s',
'3.423s', '3.581s', '3.748s', '3.923s', '4.103s', '4.293s', '4.491s', '4.696s', '4.908s', '5.130s',
'5.361s', '5.601s', '5.846s', '6.104s', '6.371s', '6.647s', '6.929s', '7.225s', '7.531s', '7.847s',
'8.169s', '8.506s', '8.853s', '9.212s', '9.577s', '9.958s', '10.35s', '10.75s', '11.16s', '11.59s',
'12.03s', '12.48s', '12.94s', '13.42s', '13.91s', '14.41s', '14.93s', '15.46s', '16.00s', '16.56s',
'17.13s', '17.72s', '18.32s', '18.93s', '19.56s', '20.21s', '20.87s', '21.54s', '22.23s', '22.94s',
'23.66s', '24.40s', '25.16s', '25.93s', '26.72s', '27.52s', '28.35s', '29.19s', '30.04s', '30.92s',
'31.82s', '32.73s', '33.66s', '34.61s', '35.58s', '36.57s', '37.57s', '38.60s', '39.65s', '40.72s',
'41.80s', '42.91s', '44.04s', '45.19s', '46.35s', '47.55s', '48.76s', '50.00s'
};

bSkyDecayText1 = DecayTextArray[midiVal];


/*
// Apply the cubic regression curve
decl rawDecay = -0.109 * pow(midiVal, 3) + 0.138 * pow(midiVal, 2) + 36.993 * midiVal + 1.003;


// Optional clamp to valid range
rawDecay = clamp(rawDecay, 0, 127);

// Round to whole number for display (if preferred)
decl decayRounded = floor(rawDecay + 0.500);


// Decide suffix
decl suffix;
if (decayRounded == 1000) {
  suffix = 'ms';
} else {
  suffix = 's';
}


// Format result and assign to global display variable
*/ 
//bSkyDecayText1 = decayRounded ; //  & suffix;" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyCloud/calcNewDecayText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

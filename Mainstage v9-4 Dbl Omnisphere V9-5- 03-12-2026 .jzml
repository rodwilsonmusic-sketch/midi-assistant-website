decl bSkynumLc2 = (bSkyText2Num-1) ;


decl shiftName1 = shiftListLc[bSkynumLc1] ;

decl shiftName2 = shiftListLc2[bSkynumLc2] ;

setattribute(Shift1Text,'content',shiftName1);

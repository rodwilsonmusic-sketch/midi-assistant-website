<PARAM name="x=" value="1.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000" send="17" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/ContainerBSkyCloud/SwitchPreset1/x" midi_target="-1" midi_trigger="1" midi_message="0xCF,0xCF,0,78" midi_scale="0,16383" osc_scale="0.000000,1.000000" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>

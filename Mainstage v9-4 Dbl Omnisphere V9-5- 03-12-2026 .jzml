<SCRIPT name="channelset49()" script="decl xval = round(x*127) ;

decl xcc ;

if (spitfireCC == 1) {
xcc = 26 ;
}
else {
xcc = 49 ;
}



if (faderChannel1 == 1)
{
        xcc = 22 ;
        ctlout(0, xcc, xval, 1); //target 0, cc, value value, channel1
}
else if (ccChannelControl > 0)
{
        ctlout(0, xcc, xval, ccChannelControl); //target 0, cc, value , channel16
}
else {

       ctlout(0, xcc, xval, 16); //target 0, cc, value , channel16
}" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/Fader28/channelset49" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

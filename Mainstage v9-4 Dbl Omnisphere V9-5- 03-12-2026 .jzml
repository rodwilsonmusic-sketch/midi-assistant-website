<SCRIPT name="setVowelVal()" script="
//setbskyModeVal() ; 

decl xval = x ;
decl xsel = firstof(xval) ;

decl xmval ;

if (xsel == 0) { xmval = 5 ;}
else if  (xsel == 1)  {  xmval =20 ;}
else if  (xsel == 2)  {  xmval =40 ;}
else if  (xsel == 3)  {  xmval =60 ;}
else if  (xsel == 4)  {  xmval =80 ;}
else if  (xsel == 5)  {  xmval = 100 ;}

else xmval =120 ;
bSkyVowelNum = xsel+1;

ctlout(0 ,28, xmval,BSkyMidiChannel) ;  //target 0, cc, value value, channel1

setVowelValText();
" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyDrone/ContainerBSkyChorale/SwitchVowel/setVowelVal" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

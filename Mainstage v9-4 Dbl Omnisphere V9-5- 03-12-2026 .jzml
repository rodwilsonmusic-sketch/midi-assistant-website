 xon = xval[xpos] ;
 lastSwitchKey0[i] = xval[i];

if (xpos == 0 )  
{ 
xnote = 54 ;  // F#2
 }

else if (xpos == 1) 
{ 
xnote = 56 ; // G#2
} 

else if (xpos == 2) 
{ 
xnote = 58 ; // A#2
} 



else if (xpos == 3) 
{ 


break ;  // B3
} 



droneNoteVal = xnote;
droneNoteOn = xon;

setDroneNote();
setDroneNoteName();


}

}

lastSwitchKey0 = x ;  
" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/SwitchKey0/sendNoteValue" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

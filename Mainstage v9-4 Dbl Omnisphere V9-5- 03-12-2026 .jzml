<SCRIPT name="setbskyModeVal()" script="
decl xsel = firstof(ContainerBSkyShimmer.ModeSwitch2.x) ;




decl xmval ;

if (xsel == 0) 
{
xmval = 3 ;
bskySwitchMode1Num = xmval ;
}

else if (xsel == 1)
{

xmval = 63 ;
bskySwitchMode1Num = xmval ;
}

else 
{
xmval = 120 ;
bskySwitchMode1Num = xmval ;

}

bskyval1 = xmval;


//bskySwitchMode1Num = mval;

ctlout(0,76, xmval, 16) ;  //target 0, cc, value value, channel1" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyElPn/ContainerBSkyBloom/setbskyModeVal" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="translateDecayTextNew()" script="
decl xtextval = bSkyDecayText1 ;

decl ttext  = xtextval ;

decl sulfixText ;


if (bSkyBloomDecayMidiNum < 41) 
{ sulfixText = ' ms';

//ttext = round(xtextval)  ;
//ttext = ttext & ' ms';
//setattribute(ContainerBlueSkyPn.ContainerBSkyShimmer.DecayDisplayText,'content',ttext);
setattribute(DecayMonitor2,'precision',1);
setattribute(DecayMonitor2,'unit',' ms');



// DecayMonitor2
}


else if (bSkyBloomDecayMidiNum < 102) 
{
//ttext = round(xtextval)/1000  ;
//ttext = ttext & 's ';

sulfixText = 's';

setattribute(DecayMonitor2,'precision',3);
setattribute(DecayMonitor2,'unit',' s');

}

else // if (xtextval < 10000) 
{
//ttext = round(xtextval)  ;
//ttext = ttext & 's ';
//setattribute(ContainerBSkyChorale.DecayDisplayText,'content',ttext);
setattribute(DecayMonitor2,'precision',2);
setattribute(DecayMonitor2,'unit',' s');

}


bSkyDecayTranText1 = ttext & sulfixText ;


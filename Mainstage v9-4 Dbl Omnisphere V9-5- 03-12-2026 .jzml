<PARAM name="x=" value="1.000000,0.000000" send="17" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/ContainerBSkyBloom/SwitchInfFreeze2/x" midi_target="-1" midi_trigger="1" midi_message="0xBF,0xBF,77,77" midi_scale="0,16383" osc_scale="0.000000,1.000000" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="light=0" send="0" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/ContainerBSkyBloom/SwitchInfFreeze2/light" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="SelInfiniiteFreeze()" script="

//setbskyModeVal() ; 

decl xval = x ;
decl xsel = firstof(xval) ;

decl xmval ;

if (xsel == 0) 
{
xmval = 5 ;

}

else xmval =120 ;


ctlout(0 , 14, xmval, 6) ;  //target 0, cc, value value, channel1
" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/ContainerBSkyBloom/SwitchInfFreeze2/SelInfiniiteFreeze" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

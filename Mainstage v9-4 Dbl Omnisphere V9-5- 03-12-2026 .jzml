<SCRIPT name="setModeSwitch()" script="

//setbskyModeVal() ; 

decl xval = x ;
decl xsel = firstof(xval) ;

decl xmval ;

if (xsel == 0) 
{
xmval = 120 ;
bskySwitchMode1Num = xmval ;
}

else if (xsel == 1)
{

xmval = 62 ;
bskySwitchMode1Num = xmval ;
}

else 
{
xmval = 3 ;
bskySwitchMode1Num = xmval ;
}

bskyval1 = xmval;

bskySwitchMode1Num = xmval ;

ctlout(0,76, xmval, 16) ;  //target 0, cc, value value, channel1
" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyShimmer/ModeSwitch2/setModeSwitch" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

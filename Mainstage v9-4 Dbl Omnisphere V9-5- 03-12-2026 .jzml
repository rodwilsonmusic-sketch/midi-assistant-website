<SCRIPT name="setResetBar()" script="
decl notenumber = 24 ;

decl notechannel = 15 ;


//  ctlout(0, xcc, xval, 1); //target 0, cc, value value, channel1

//noteout(target,note,vel,chan) : outputs a Note On MIDI message with specified
//Target, Controller number, value and channel.

noteout(0,notenumber,127,15);

" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/Presets/setResetBar" midi_message="0x90,0x9F,0,127" midi_target="0" flag="0"/>
<SCRIPT name="setLastNotePad()" script="
decl lx = x ;
decl lval = 0 ;
decl lnoteStart = 24 ;
decl lLastNoteNum = 0 ;

lval = firstof(x) ;
lastPadVal = lval ;

if((lval+lnoteStart) != lastNoteNum)
{ 
   
   noteout(0,lastNoteNum,0,15);


   noteout(0,lnoteStart,127,15);

   noteout(0,lnoteStart,0,15);
  

   lastNoteNum = lval+lnoteStart ;

   noteout(0,lastNoteNum,127,15);

}


//If lcx== 127 and x(0) = 127
		//then lcv = 1
//elseif  lcx== 127 and x(1) = 127


" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/Presets/setLastNotePad" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

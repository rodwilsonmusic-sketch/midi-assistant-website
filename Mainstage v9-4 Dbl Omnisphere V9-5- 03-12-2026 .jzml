<SCRIPT name="setResonanceVal()" script="
//setbskyModeVal() ; 

decl xval = x ;
decl xsel = firstof(xval) ;

decl xmval ;

if (xsel == 0) {xmval = 120 ;}
else if (xsel == 1) {xmval = 60 ;}
else xmval =5 ;


ctlout(0 ,27, xmval,BSkyMidiChannel) ;  //target 0, cc, value value, channel1
" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkySyn/ContainerBSkyChorale/SwitchResonance/setResonanceVal" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

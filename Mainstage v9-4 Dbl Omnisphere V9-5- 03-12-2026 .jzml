<SCRIPT name="showBlueSky1Container()" script="decl ishide = x ;

if (ishide == 1) {

show(ContainerBlueSkyPad2,1) ; 
//show(ContainerBlueSkyDrone1) ;
show(ContainerBlueSkySyn,0) ;
CustomButtonShowBlueSkySyn.x = 0;


}
else {

show(ContainerBlueSkyPad2,0) ;  // set back to 0
//show(ContainerBlueSkyDrone1,0) ;


}
" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/CustomButtonShowBlueSkyPad2/showBlueSky1Container" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

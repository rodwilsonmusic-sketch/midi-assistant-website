else if (BSkyShift2MidiNum < 68) { blueskyShift2Num  = 15 ; BSkyShift2MidiNum = 63 ;}
else if (BSkyShift2MidiNum < 72) { blueskyShift2Num  = 16 ; BSkyShift2MidiNum = 68 ;}
else if (BSkyShift2MidiNum < 77) { blueskyShift2Num  = 17 ; BSkyShift2MidiNum = 72 ;}
else if (BSkyShift2MidiNum < 81) { blueskyShift2Num  = 18 ; BSkyShift2MidiNum = 77 ;}
else if (BSkyShift2MidiNum < 86) { blueskyShift2Num  = 19 ; BSkyShift2MidiNum = 81 ;}

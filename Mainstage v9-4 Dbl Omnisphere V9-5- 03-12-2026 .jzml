<SCRIPT name="setResonanceVal()" script="
//setbskyModeVal() ; 

decl xval = x ;
decl xsel = firstof(xval) ;

decl xmval ;

if (xsel == 0) {xmval = 120 ;}
else if (xsel == 1) {xmval = 60 ;}
else xmval =5 ;


ctlout(0 ,27, xmval,BSkyMidiChannel) ;  //target 0, cc, value value, channel1

<SCRIPT name="ResetOmispherePads()" script="
 if (sw16cc32val==1) ctlout(0, 32, 127, 16) ;  //target 0, cc, value value, channel1
 if (sw16cc33val==1) ctlout(0, 33, 127, 16) ;
 if (sw16cc34val==1) ctlout(0, 34, 127, 16) ;
 if (sw16cc35val==1) ctlout(0, 35, 127, 16) ;
 if (sw16cc36val==1) ctlout(0, 36, 127, 16) ;
 if (sw16cc37val==1) ctlout(0, 37, 127, 16) ;
 if (sw16cc38val==1) ctlout(0, 38, 127, 16) ;
 if (sw16cc39val==1) ctlout(0, 39, 127, 16) ;
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ResetOmispherePads" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

<SCRIPT name="setFaderValue()" script="// Get current X and Y positions of the first ball
decl valx = MB1.x[0];  // X position of ball 0
decl valy = MB1.y[0];  // Y position of ball 0
decl ccx = valx*127 ;
decl ccy = valy*127 ;

if (!ReceivingFeedback==1 && MB1.z[0] == 1 ) {

if ( !ReceivingFeedbackX ) {
 //ctlout(0,64, ccx, 13);
  valXSndBnd = valx ;
}

if ( !ReceivingFeedbackY ) {
 //ctlout(0,65, ccy, 13);
  valYSndBnd = valy ;
}




/*

if (MB1.z[0]) {

  valXSndBnd = valx ;
  ctlout(0,64, ccx, 13);  //ctlout(0, 32, 127, 16) ;  //target 0, cc, value value, channel1
}}


/*
if (MB1.z[0]) {
  valYSndBnd = valy ;
 ctlout(0,65, ccy, 13)  ; 
}}
*/
}


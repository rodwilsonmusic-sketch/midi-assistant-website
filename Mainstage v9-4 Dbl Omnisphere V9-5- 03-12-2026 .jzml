<SCRIPT name="setVowelValText()" script="
decl vowelListLc =  {'AAHHOO','AAHH','AAHOH','OH','OOOHOH','OOOO','RANDOM'};  


decl bSkynumVal = (bSkyVowelNum-1) ;


decl vowelName = vowelListLc[ bSkynumVal] ;


setattribute(VowelValText,'content',vowelName);
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkySyn/ContainerBSkyChorale/setVowelValText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="calcNewDecayText()" script="
decl midiVal = bSkyChoraleDecayMidiNum; 
/*
decl DecayTextArray = {

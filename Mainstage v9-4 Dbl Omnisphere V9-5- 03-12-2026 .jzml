setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.DecayText1,'content',bSkyDecayText1);

//ctlout(0
}  // Section 2 Ends" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkySwell/calcSection2DecayText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

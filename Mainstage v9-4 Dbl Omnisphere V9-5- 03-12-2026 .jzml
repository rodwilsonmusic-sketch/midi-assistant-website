<PARAM name="x=" value="1.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000" send="17" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/SwitchKeys1/x" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" osc_scale="0.000000,1.000000" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="light=0" send="0" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/SwitchKeys1/light" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="SendNoteValue()" script="decl xval = x ;

decl xpos ;  // = firstof(xval);

decl xnote = 0 ;

decl xon  ;

droneNotePos = xpos ;

decl i;


//decl xtest = lastSwitchKey1[i];


for (i=0;i<15;i++)
{
if (xval[i] == lastSwitchKey1[i]) 
{
continue ;
}

else
{
 xpos = i;

 xon = xval[xpos] ;
 lastSwitchKey1[i] = xval[i];

if (xpos == 0 )  
{ 
xnote = 53 ;  // F2
 }

else if (xpos == 1) 
{ 
xnote = 55 ; //G2
} 

else if (xpos == 2) 
{ 
xnote = 57 ; // A2
} 

else if (xpos == 3) 
{ 
xnote = 59 ; // B2
} 

//////////////

if (xpos == 4 )  
{ 
xnote = 60 ;  // C3
 }

else if (xpos == 5) 
{ 
xnote = 62 ; // D3
} 

else if (xpos == 6) 
{ 
xnote = 64 ; // E3
} 

else if (xpos == 7) 
{ 
xnote = 65 ; // F3
} 

else if (xpos == 8) 
{ 
xnote = 67 ; // G3
    
} 

else if (xpos == 9) 
{ 
xnote = 69 ;   // A3
} 

else if (xpos == 10) 
{ 
xnote = 71 ;   // B3
} 

else if (xpos == 11) 
{ 
xnote = 72 ;  // C3
} 

/////////


else if (xpos == 12) 
{ 
xnote = 74 ;   // D3
} 

else if (xpos == 13) 
{ 
xnote = 76 ;  // E3
} 



else if (xpos == 14) 
{ 


break ;  // B3
} 



droneNoteVal = xnote;
droneNoteOn = xon;

setDroneNote();
setDroneNoteName();
}

}

lastSwitchKey1 = x ;  
" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/SwitchKeys1/SendNoteValue" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

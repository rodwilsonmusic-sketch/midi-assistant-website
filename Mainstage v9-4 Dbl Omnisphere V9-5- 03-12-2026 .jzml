<SCRIPT name="EnableStake()" script="decl valx = 0.00 ;

valx = x;



decl ccv1 ;
ccv1 = valx*100 ;

/*
if (valx  < 0.05) 
 {
   ccv1 =100.00
  } ;

else {ccv1 = 100.00 } ;    
*/ 


testNoteXVal = ccv1;



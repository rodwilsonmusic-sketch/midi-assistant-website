<SCRIPT name="calcSection1DecayText()" script="
decl knobValue = bSkyDecayKnobVal;  // ContainerBSkyShimmer.DecayKnob1.x ;
decl xtext ;

decl start ;
decl end ;
decl t ;
decl decayTime; 
decl sulfix = '' ;

if (knobValue <= 0.8013444 )  // 8051398  //7952756//7792455//8043170 // 8013444
{  // Begin Section 1 DecayKnob1

if (knobValue <= 0.2003814) 
{
   start = 500 ; 
   end = 603 ;
   t = knobValue / 0.2003814 ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 'ms' ;
}

else if (knobValue <= 0.2454578) 
{
   start = 603 ; 
   end = 706 ;
   t = (knobValue - 0.2003814) / (0.2454578 - 0.2003814 ) ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 'ms' ;
}


else if (knobValue <= 0.3149614) 
{
   start = 706 ; 
   end = 1000 ;
   t = (knobValue - 0.2454578) / (0.3149614 - 0.2454578 ) ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 'ms' ;
}


else if  (knobValue <= 0.4488185)
{
   t = (knobValue - 0.3149614) / (0.4488185 - 0.3149614); 
   start = 1000.000 ; 
   end = 2000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.5364360)   //  5275588  //527559  // 5364360
{
   t = (knobValue - 0.4488185) / (0.5364360 - 0.4488185); 
   start = 2000.000 ; 
   end = 3000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

//527559
//5826772

else if  (knobValue <= 0.5826772) // 5832058  // 5826772 // 5911982
{
   t = (knobValue - 0.5364360) / (0.5826772 - 0.5364360); 
   start = 3000.000 ; 
   end = 4000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.6367752)   //  6300384 // 6299213  // 6367752
{
   t = (knobValue - 0.5826772) / (0.6367752 - 0.5826772); 
   start = 4000.000 ; 
   end = 5000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.6704680)  // 6692913 // 6704680  
{
   t = (knobValue - 0.6367752) / (0.6704680 - 0.6367752); 
   start = 5000.000 ; 
   end = 6000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.7096887) // 7096887 // 7086614
{
   t = (knobValue - 0.6704680) / (0.7096887 - 0.6704680); 
   start = 6000.000 ; 
   end = 7000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.7411927) // 7411927  // 7401575
{
   t = (knobValue - 0.7096887) / (0.7411927 - 0.7096887); 
   start = 7000.000 ; 
   end = 8000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.7728114)  // 7728114  // 7716535
{
   t = (knobValue - 0.7411927) / (0.7728114 - 0.7411927); 
   start = 8000.000 ; 
   end = 9000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if  (knobValue <= 0.8013444)  // 8051398 // 7952756 // 8043170//8049910 //8041290 //8013444
{
   t = (knobValue - 0.7728114) / (0.8013444 - 0.7728114); 
   start = 9000.000 ; 
   end = 10000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}




//7952756               //9055118   15
//7716535              // 9291338    16
//7401575             // 9448819    17
//6692913             // 96006299   18
//6299213            //  9763780   19
//7086614 
//8188977  11
//8425197  12
// 8661417  13
//8897638    14

decayTime = decayTime & sulfix;

/*
function lerp(start, end, t)
    return (1 - t) * start + t * end;
end
if (knobValue <= 0.31496) then
    t = knobValue / 0.31496;  -- Normalize the knobValue to range [0, 1] for this segment
    delayTime = lerp(500, 1000, t);
elseif (knobValue <= 0.79528) then
    t = (knobValue - 0.31496) / (0.79528 - 0.31496);  -- Normalize for this segment
    delayTime = lerp(1000, 10000, t);
else
    t = (knobValue - 0.79528) / (1 - 0.79528);  -- Normalize for this segment
    delayTime = lerp(10000, 20000, t);
end
*/

bSkyDecayText1 = decayTime ;

//setBSkyDelayText();

//setattribute(ContainerBlueSkyPad1.DecayText1,'content',bSkyDecayText1);

//ctlout(0

}  /// End of Section 1 " trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyElPn/ContainerBSkyChorale/calcSection1DecayText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="0"/>
<SCRIPT name="calcSection2DecayText()" script="
decl knobValue = bSkyDecayKnobVal;//ContainerBSkyShimmer.DecayKnob1.x ;
decl xtext ;

decl start ;
decl end ;
decl t ;
decl delayTime; 
decl sulfix = '' ;

//---- Section 2

if  (knobValue > 0.8013444)   //8051398 // 7792455 //8043170 // 8049910
{   // Section 2 Begins
if   (knobValue <= 0.8267717)  // 8267717 // 8188977
{
   t = (knobValue - 0.8013444) / (0.8267717 - 0.8013444); 
   start = 10000.000 ; 
   end = 11000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if   (knobValue <= 0.8425197)  
{
   t = (knobValue - 0.8267717) / (0.8425197 - 0.8267717); 
   start = 11000.000 ; 
   end = 12000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.8661417)
{

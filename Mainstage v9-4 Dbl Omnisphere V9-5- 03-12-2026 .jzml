<VARIABLE name="MidiInitialized=" value="1" send="1" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/MidiInitialized" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="setBSkyEffect()" script="decl effectTypeTextval ;
decl xval =bSkyPadEffectType1 ; 

decl xinc = 127/12 ;
decl xmidival ;


if (xval == 0 )
{   
xmidival = xinc * 11 ;
bSkyEffectTypeText1 = 'Spring' ;
}



if (xval == 1)
{   
xmidival = xinc * 1 ;
bSkyEffectTypeText1 = 'Cloud' ;
}


if (xval == 2)
{   
xmidival = xinc * 2.5 ;
bSkyEffectTypeText1 = 'Choral' ;
}

if (xval == 3)
{   
xmidival = xinc * 9.5 ;
bSkyEffectTypeText1 = 'Plate' ;
}


if (xval == 4)
{   
xmidival = xinc * 12.5 ;
bSkyEffectTypeText1 = 'Bloom' ;
}

if (xval == 5)
{   
xmidival = xinc * 3 ;
bSkyEffectTypeText1 = 'Shimmer' ;

}

if (xval == 6)
{   
xmidival = xinc * 9 ;
bSkyEffectTypeText1 = 'Hall' ;
}

if (xval == 7)
{   
xmidival = xinc * 12 ;
bSkyEffectTypeText1 = 'Swell' ;
}

if (xval == 8)
{   
xmidival = xinc * 4 ;
bSkyEffectTypeText1 = 'Magneto' ;
}


if (xval == 9)
{   
xmidival = xinc * 8 ;
bSkyEffectTypeText1 = 'Room' ;
}



if (xval == 10)
{   
xmidival = xinc * 7 ;
bSkyEffectTypeText1 = 'Reflections' ;
}





if (xval == 11)
{   
xmidival = xinc * 5 ;
bSkyEffectTypeText1 = 'Non Linear' ;
}



bSkyEffectVal  = xmidival ;


setattribute(ContainerBlueSkyPad1.EffectTypeText1,'content',bSkyEffectTypeText1);
ctlout(0,70, xmidival, 16) ;  //target 0, cc, value value, channel1
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/setBSkyEffect" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="setBSkyMidiChannel()" script="
if (MidiInitialized == 0) {
    BSkyMidiChannel = 6;
    MidiInitialized = 1;
}


" trigger_script="" trigger_type="1" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/setBSkyMidiChannel" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

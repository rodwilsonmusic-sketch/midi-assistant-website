<SCRIPT name="setPadShift2Num()" script="decl lx = abs(29.5) *x ;


//blueskyShift2Num = lx ;

ContainerBlueSkyPad1.BSkyShift2MidiNum = round(x*127) ;

ContainerBlueSkyPad1.BSkyAcctShift2Num = ContainerBlueSkyPad1.BSkyShift2MidiNum;
ContainerBlueSkyPad1.ContainerBSkyShimmer.setBSkyShift2TextVal();
ContainerBlueSkyPad1.ContainerBSkyShimmer.Shift2.x = ContainerBlueSkyPad1.BSkyShift2MidiNum ;
ContainerBlueSkyPad2.ContainerBSkyShimmer.Shift2.x = ContainerBlueSkyPad1.BSkyShift2MidiNum ;


/*
if (BSkyShift2MidiNum < 4) { blueskyShift2Num  = 1 ;   BSkyShift2MidiNum = 0 ;}
else if (BSkyShift2MidiNum < 9) { blueskyShift2Num  = 2 ;  BSkyShift2MidiNum = 4 ;}
else if (BSkyShift2MidiNum < 13) { blueskyShift2Num  = 3 ; BSkyShift2MidiNum = 9 ;}
else if (BSkyShift2MidiNum < 18) { blueskyShift2Num  = 4 ; BSkyShift2MidiNum = 13 ;}
else if (BSkyShift2MidiNum < 22) { blueskyShift2Num  = 5 ; BSkyShift2MidiNum = 18 ;}

show(TextTime,0);
show(TimeKnob,0);
show(BeatKnob,1);

show(TextBeat,1);
}
else {

show(TextTime,1);
show(TimeKnob,1);
show(TextBeat,0);
show(BeatKnob,0);

}

" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerSpaceBenderPn/SyncButton/SendNextPatch" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

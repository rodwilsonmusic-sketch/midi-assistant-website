<SCRIPT name="setbskyModeVal()" script="
decl xsel = firstof(ContainerBSkyShimmer.ModeSwitch2.x) ;




decl xmval ;

if (xsel == 0) 
{
xmval = 3 ;
bskySwitchMode1Num = xmval ;
}

else if (xsel == 1)
{

xmval = 63 ;
bskySwitchMode1Num = xmval ;
}

else 
{
xmval = 120 ;
bskySwitchMode1Num = xmval ;

}

bskyval1 = xmval;


//bskySwitchMode1Num = mval;

ctlout(0,76, xmval, 16) ;  //target 0, cc, value value, channel1" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyShimmer/setbskyModeVal" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="setShiftValText()" script="

decl shiftListLc =  {'-OCT','-M7','-m7','-M6','-m6','-P5','-TRI','-P4','-M3','-m3','-M2','-m2','-10CEN','+10CEN','+m2','+M2','+m3','+M3','+P4','+TRI','+P5','+m6','+M6','+m7','+M7','+OCT','+OCT&5','+2 OCT'};  // 29


decl shiftListLc2 =  {'OFF','-OCT','-M7','-m7','-M6','-m6','-P5','-TRI','-P4','-M3','-m3','-M2','-m2','-10CEN','+10CEN','+m2','+M2','+m3','+M3','+P4','+TRI','+P5','+m6','+M6','+m7','+M7','+OCT','+OCT&5','+2 OCT'};


//decl bSkynumLc1 = round(blueskyShift1Num) ;

//if  (bSkynumLc1 > 21 ) { bSkynumLc1= bSkynumLc1 -1;}


//decl bSkynumLc2 = round(floor(blueskyShift2Num)) ;

decl bSkynumLc1 = (bSkyText1Num-1) ;
decl bSkynumLc2 = (bSkyText2Num-1) ;


decl shiftName1 = shiftListLc[bSkynumLc1] ;

decl shiftName2 = shiftListLc2[bSkynumLc2] ;

setattribute(Shift1Text,'content',shiftName1);
setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.Shift1Text,'content',shiftName1);


setattribute(Shift2Text,'content',shiftName2);
setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.Shift2Text,'content',shiftName2);
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyShimmer/setShiftValText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="setBSkyShift1TextVal()" script="if (BSkyShift1MidiNum < 4) { blueskyShift1Num  = 1 ; BSkyShift1MidiNum = 0 ;}
else if (BSkyShift1MidiNum < 9) { blueskyShift1Num  = 2 ; BSkyShift1MidiNum = 4 ;}
else if (BSkyShift1MidiNum < 14) { blueskyShift1Num  = 3 ; BSkyShift1MidiNum = 9 ;}
else if (BSkyShift1MidiNum < 18) { blueskyShift1Num  = 4; BSkyShift1MidiNum = 14 ;}
else if (BSkyShift1MidiNum < 23) { blueskyShift1Num  = 5; BSkyShift1MidiNum = 18 ;}
else if (BSkyShift1MidiNum < 28) { blueskyShift1Num  = 6; BSkyShift1MidiNum = 23 ;}
else if (BSkyShift1MidiNum < 32) { blueskyShift1Num  = 7 ; BSkyShift1MidiNum = 28 ;}
else if (BSkyShift1MidiNum < 37) { blueskyShift1Num  = 8 ; BSkyShift1MidiNum = 32 ;}

<SCRIPT name="SetShiftText()" script="
decl shiftName1;

if (blueskyShift1Num == 1) shiftName1 = '-OCT';
else if (blueskyShift1Num == 2) shiftName1 = '-M7';
else if (blueskyShift1Num == 3) shiftName1 = '-m7';
else if (blueskyShift1Num == 4) shiftName1 = '-M6';
else if (blueskyShift1Num == 5) shiftName1 = '-m6';
else if (blueskyShift1Num == 6) shiftName1 = '-P5';
else if (blueskyShift1Num == 7) shiftName1 = '-TRI';
else if (blueskyShift1Num == 8) shiftName1 = '-P4';
else if (blueskyShift1Num == 9) shiftName1 = '-M3';
else if (blueskyShift1Num == 10) shiftName1 = '-m3';
else if (blueskyShift1Num == 11) shiftName1 = '-M2';
else if (blueskyShift1Num == 12) shiftName1 = '-m2';
else if (blueskyShift1Num == 13) shiftName1 = '-10CEN';
else if (blueskyShift1Num == 14) shiftName1 = '+10CEN';
else if (blueskyShift1Num == 15) shiftName1 = '+m2';
else if (blueskyShift1Num == 16) shiftName1 = '+M2';
else if (blueskyShift1Num == 17) shiftName1 = '+m3';
else if (blueskyShift1Num == 18) shiftName1 = '+M3';
else if (blueskyShift1Num == 19) shiftName1 = '+P4';
else if (blueskyShift1Num == 20) shiftName1 = '+TRI';
else if (blueskyShift1Num == 21) shiftName1 = 'P5';
else if (blueskyShift1Num == 22) shiftName1 = '+m6';
else if (blueskyShift1Num == 23) shiftName1 = '+M6';
else if (blueskyShift1Num == 24) shiftName1 = '+m7';
else if (blueskyShift1Num == 25) shiftName1 = '+M7';
else if (blueskyShift1Num == 26) shiftName1 = '+OCT';
else if (blueskyShift1Num == 27) shiftName1 = '+OCT&5';
else if (blueskyShift1Num == 28) shiftName1 = '+2 OCT';




decl shiftName2;

if (blueskyShift2Num == 1) shiftName2 = 'OFF';
else if (blueskyShift2Num == 2) shiftName2 = '-OCT';
else if (blueskyShift2Num == 3) shiftName2 = '-M7';
else if (blueskyShift2Num == 4) shiftName2 = '-m7';
else if (blueskyShift2Num == 5) shiftName2 = '-M6';
else if (blueskyShift2Num == 6) shiftName2 = '-m6';
else if (blueskyShift2Num == 7) shiftName2 = '-P5';
else if (blueskyShift2Num == 8) shiftName2 = '-TRI';
else if (blueskyShift2Num == 9) shiftName2 = '-P4';
else if (blueskyShift2Num == 10) shiftName2 = '-M3';
else if (blueskyShift2Num == 11) shiftName2 = '-m3';
else if (blueskyShift2Num == 12) shiftName2 = '-M2';
else if (blueskyShift2Num == 13) shiftName2 = '-m2';
else if (blueskyShift2Num == 14) shiftName2 = '-10CEN';
else if (blueskyShift2Num == 15) shiftName2 = '+10CEN';
else if (blueskyShift2Num == 16) shiftName2 = '+m2';
else if (blueskyShift2Num == 17) shiftName2 = '+M2';
else if (blueskyShift2Num == 18) shiftName2 = '+m3';
else if (blueskyShift2Num == 19) shiftName2 = '+M3';
else if (blueskyShift2Num == 20) shiftName2 = '+P4';
else if (blueskyShift2Num == 21) shiftName2 = '+TRI';
else if (blueskyShift2Num == 22) shiftName2 = '+P5';
else if (blueskyShift2Num == 23) shiftName2 = '+m6';
else if (blueskyShift2Num == 24) shiftName2 = '+M6';
else if (blueskyShift2Num == 25) shiftName2 = '+m7';
else if (blueskyShift2Num == 26) shiftName2 = '+M7';
else if (blueskyShift2Num == 27) shiftName2 = '+OCT';
else if (blueskyShift2Num == 28) shiftName2 = '+OCT&5';
else if (blueskyShift2Num == 29) shiftName2 = '+2 OCT';


gShift1Name =shiftName1;
gShift2Name =shiftName2;


setattribute(Shift1Text,'content',shiftName1);
setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.Shift1Text,'content',shiftName1);


setattribute(Shift2Text,'content',shiftName2);
setattribute(ContainerBlueSkyPad1.ContainerBSkyShimmer.Shift2Text,'content',shiftName2);

" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPn/ContainerBSkyChorale/SetShiftText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="calcSection1DecayText()" script="
decl knobValue = bSkyDecayKnobVal;  // ContainerBSkyShimmer.DecayKnob1.x ;
decl xtext ;

decl start ;
decl end ;
decl t ;
decl decayTime; 
decl sulfix = '' ;

if (knobValue <= 0.8013444 )  // 8051398  //7952756//7792455//8043170 // 8013444
{  // Begin Section 1 DecayKnob1

if (knobValue <= 0.2003814) 
{
   start = 500 ; 
   end = 603 ;
   t = knobValue / 0.2003814 ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 'ms' ;
}

else if (knobValue <= 0.2454578) 
{
   start = 603 ; 
   end = 706 ;
   t = (knobValue - 0.2003814) / (0.2454578 - 0.2003814 ) ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 'ms' ;
}


else if (knobValue <= 0.3149614) 
{
   start = 706 ; 
   end = 1000 ;
   t = (knobValue - 0.2454578) / (0.3149614 - 0.2454578 ) ;  
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 'ms' ;
}


else if  (knobValue <= 0.4488185)
{
   t = (knobValue - 0.3149614) / (0.4488185 - 0.3149614); 
   start = 1000.000 ; 
   end = 2000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.5364360)   //  5275588  //527559  // 5364360
{
   t = (knobValue - 0.4488185) / (0.5364360 - 0.4488185); 
   start = 2000.000 ; 
   end = 3000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

//527559
//5826772

else if  (knobValue <= 0.5826772) // 5832058  // 5826772 // 5911982
{
   t = (knobValue - 0.5364360) / (0.5826772 - 0.5364360); 
   start = 3000.000 ; 
   end = 4000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.6367752)   //  6300384 // 6299213  // 6367752
{
   t = (knobValue - 0.5826772) / (0.6367752 - 0.5826772); 
   start = 4000.000 ; 
   end = 5000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.6704680)  // 6692913 // 6704680  
{
   t = (knobValue - 0.6367752) / (0.6704680 - 0.6367752); 
   start = 5000.000 ; 
   end = 6000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.7096887) // 7096887 // 7086614
{
   t = (knobValue - 0.6704680) / (0.7096887 - 0.6704680); 
   start = 6000.000 ; 
   end = 7000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.7411927) // 7411927  // 7401575
{
   t = (knobValue - 0.7096887) / (0.7411927 - 0.7096887); 
   start = 7000.000 ; 
   end = 8000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if  (knobValue <= 0.7728114)  // 7728114  // 7716535
{
   t = (knobValue - 0.7411927) / (0.7728114 - 0.7411927); 
   start = 8000.000 ; 
   end = 9000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if  (knobValue <= 0.8013444)  // 8051398 // 7952756 // 8043170//8049910 //8041290 //8013444
{
   t = (knobValue - 0.7728114) / (0.8013444 - 0.7728114); 
   start = 9000.000 ; 
   end = 10000.000 ;
   decayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}




//7952756               //9055118   15
//7716535              // 9291338    16
//7401575             // 9448819    17
//6692913             // 96006299   18
//6299213            //  9763780   19
//7086614 
//8188977  11
//8425197  12
// 8661417  13
//8897638    14

decayTime = decayTime & sulfix;

/*
function lerp(start, end, t)
    return (1 - t) * start + t * end;
end
if (knobValue <= 0.31496) then
    t = knobValue / 0.31496;  -- Normalize the knobValue to range [0, 1] for this segment
    delayTime = lerp(500, 1000, t);
elseif (knobValue <= 0.79528) then
    t = (knobValue - 0.31496) / (0.79528 - 0.31496);  -- Normalize for this segment
    delayTime = lerp(1000, 10000, t);
else
    t = (knobValue - 0.79528) / (1 - 0.79528);  -- Normalize for this segment
    delayTime = lerp(10000, 20000, t);
end
*/

bSkyDecayText1 = decayTime ;

//setBSkyDelayText();

//setattribute(ContainerBlueSkyPad1.DecayText1,'content',bSkyDecayText1);

//ctlout(0

}  /// End of Section 1 " trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPn/ContainerBSkyChorale/calcSection1DecayText" midi_message="0x90,0x90,0,0" midi_target="-1" flag="0"/>
<SCRIPT name="calcSection2DecayText()" script="
decl knobValue = bSkyDecayKnobVal;//ContainerBSkyShimmer.DecayKnob1.x ;
decl xtext ;

decl start ;
decl end ;
decl t ;
decl delayTime; 
decl sulfix = '' ;

//---- Section 2

if  (knobValue > 0.8013444)   //8051398 // 7792455 //8043170 // 8049910
{   // Section 2 Begins
if   (knobValue <= 0.8267717)  // 8267717 // 8188977
{
   t = (knobValue - 0.8013444) / (0.8267717 - 0.8013444); 
   start = 10000.000 ; 
   end = 11000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if   (knobValue <= 0.8425197)  
{
   t = (knobValue - 0.8267717) / (0.8425197 - 0.8267717); 
   start = 11000.000 ; 
   end = 12000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.8661417)
{
   t = (knobValue - 0.8425197) / (0.8661417 - 0.8425197); 
   start = 12000.000 ; 
   end = 13000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.8897638)
{
   t = (knobValue - 0.8661417) / (0.8897638 - 0.8661417); 
   start = 13000.000 ; 
   end = 14000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.9126602) // 9126602 // 9055118
{
   t = (knobValue - 0.8897638) / (0.9126602 - 0.8897638); 
   start = 14000.000 ; 
   end = 15000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.9291338)
{
   t = (knobValue - 0.9126602) / (0.9291338 - 0.9126602); 
   start = 15000.000 ; 
   end = 16000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.9512940)  // 9492940 // 94488
{
   t = (knobValue - 0.9291338) / (0.9512940 - 0.9291338); 
   start = 16000.000 ; 
   end = 17000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

else if   (knobValue <= 0.9715940) //9668000 // 96006299 // 9715940
{
   t = (knobValue - 0.9512940) / (0.9715940 - 0.9512940); 
   start = 17000.000 ; 
   end = 18000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}
else if   (knobValue <= 0.9858823)   // 9878429 //9763780 // 9858823 
{
   t = (knobValue - 0.9715940) / (0.9858823 - 0.9715940); 
   start = 18000.000 ; 
   end = 19000.000 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}



//7952756               //9055118   15
//7716535              // 9291338    16
//7401575             // 9448819    17
//6692913             // 96006299   18
//6299213            //  9763780   19
//7086614 
//8188977  11
//8425197  12
// 8661417  13
//8897638    14

else
{
    t = (knobValue - 0.9858823) / (1 - 0.9858823);  // -- Normalize for this segment
   start = 19000.00 ; 
   end = 20000.00 ;
   delayTime = (1 - t) * start +t * end ; 
   sulfix = 's' ;
}

delayTime = delayTime & sulfix;

/*
function lerp(start, end, t)
    return (1 - t) * start + t * end;
end
if (knobValue <= 0.31496) then

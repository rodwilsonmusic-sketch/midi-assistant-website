//decl ccv1 = ((127/28) * blueskyShift1Num)+1 ;

//decl ccv2 = (127/29) * blueskyShift2Num+1 ;

*/" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyChorale/SwitchPreset1/setBSkyPresets" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

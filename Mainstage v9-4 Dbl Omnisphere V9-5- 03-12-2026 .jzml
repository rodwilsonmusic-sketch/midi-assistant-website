}" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/Fader6/channelset49" midi_message="0x90,0x90,0,0" midi_target="-1" flag="0"/>

<VARIABLE name="topRangeNoteName=" value="'A#6'" send="1" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerPadOctaveSplitter/topRangeNoteName" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="SetDownBreakPointNoteName()" script="
decl xShiftNoteVal = DownBreakPointNote ;

decl midiNote = xShiftNoteVal ;

// Arrays for Note Names (C, C#, D, ..., B)
decl noteNames = { 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B' };


decl octave = floor(midiNote / 12) - 2; // Calculate the octave (-1 to 9)
decl noteIndex = midiNote % 12; // Get note index in the scale

if (xShiftNoteVal == 0 )
{
 DownBreakPointNoteName = 'OFF' ;

   decl xf = 1;   
   //ctlout(0, 39, 0 , 14) ; // ctlout( midiport , CCNumber, Value, Channel);

}
else  
{
    
DownBreakPointNoteName = noteNames[noteIndex] + octave; // Construct the note name
// ctlout(0, 39, 127 , 14) ;
  //noteout( 0, xdroneNoteVal, 100, 1) ;
//   ctlout(0, 102,xdroneNoteVal , 2) ;
}





//setattribute(DroneNoteNameText,'content',droneNoteName);
setattribute(ContainerPadOctaveSplitter.NoteNameDnText,'content',DownBreakPointNoteName);
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerPadOctaveSplitter/SetDownBreakPointNoteName" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="SetUpBreakPointNoteName()" script="
decl xShiftNoteVal = UpBreakPointNote ;

decl midiNote = xShiftNoteVal ;

// Arrays for Note Names (C, C#, D, ..., B)
decl noteNames = { 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B' };


decl octave = floor(midiNote / 12) - 2; // Calculate the octave (-1 to 9)
decl noteIndex = midiNote % 12; // Get note index in the scale

if (xShiftNoteVal == 0 )
{
 UpBreakPointNoteName = 'OFF' ;

   decl xf = 1;   
   //ctlout(0, 39, 0 , 14) ; // ctlout( midiport , CCNumber, Value, Channel);

}
else  
{
    
UpBreakPointNoteName = noteNames[noteIndex] + octave; // Construct the note name
// ctlout(0, 39, 127 , 14) ;
  //noteout( 0, xdroneNoteVal, 100, 1) ;
//   ctlout(0, 102,xdroneNoteVal , 2) ;
}





//setattribute(DroneNoteNameText,'content',droneNoteName);
setattribute(ContainerPadOctaveSplitter.NoteNameUpText,'content',UpBreakPointNoteName);
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerPadOctaveSplitter/SetUpBreakPointNoteName" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="SetDownBreakPointNoteName2()" script="
decl xShiftNoteVal = DownBreakPointNote ;

decl midiNote = xShiftNoteVal ;

// Arrays for Note Names (C, C#, D, ..., B)
decl noteNames = { 'C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B' };


decl octave = floor(midiNote / 12) - 2; // Calculate the octave (-1 to 9)
decl noteIndex = midiNote % 12; // Get note index in the scale

if (xShiftNoteVal == 0 )
{
 DownBreakPointNoteName = 'OFF' ;

   decl xf = 1;   
   //ctlout(0, 39, 0 , 14) ; // ctlout( midiport , CCNumber, Value, Channel);

}
else  
{
    
DownBreakPointNoteName = noteNames[noteIndex] + octave; // Construct the note name
// ctlout(0, 39, 127 , 14) ;
  //noteout( 0, xdroneNoteVal, 100, 1) ;
//   ctlout(0, 102,xdroneNoteVal , 2) ;
}





//setattribute(DroneNoteNameText,'content',droneNoteName);
setattribute(ContainerPadOctaveSplitter.NoteNameDnText,'content',DownBreakPointNoteName);
" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerPadOctaveSplitter/SetDownBreakPointNoteName2" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

<VARIABLE name="light=0" send="0" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkySyn/ContainerBSkyCloud/Text10/light" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
</WINDOW>

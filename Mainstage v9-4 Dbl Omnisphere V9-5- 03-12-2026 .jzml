<SCRIPT name="setDrShift1Num()" script="decl lx = 30 *x ;
//decl xtext = 'Vibrato' ;
//decl lc = '' ;

drBSkyShift1MidiNum = round(x*127) ;

if (drBSkyShift1MidiNum < 4) { drblueskyShift1Num  = 1 ; drBSkyShift1MidiNum = 0 ;}
else if (drBSkyShift1MidiNum < 9) { drblueskyShift1Num  = 2 ; drBSkyShift1MidiNum = 4 ;}
else if (drBSkyShift1MidiNum < 14) { drblueskyShift1Num  = 3 ; drBSkyShift1MidiNum = 9 ;}
else if (drBSkyShift1MidiNum < 18) { drblueskyShift1Num  = 4; drBSkyShift1MidiNum = 14 ;}
else if (drBSkyShift1MidiNum < 23) { drblueskyShift1Num  = 5; drBSkyShift1MidiNum = 18 ;}
else if (drBSkyShift1MidiNum < 28) { drblueskyShift1Num  = 6; drBSkyShift1MidiNum = 23 ;}
else if (drBSkyShift1MidiNum < 32) { drblueskyShift1Num  = 7 ; drBSkyShift1MidiNum = 28 ;}
else if (drBSkyShift1MidiNum < 37) { drblueskyShift1Num  = 8 ; drBSkyShift1MidiNum = 32 ;}
else if (drBSkyShift1MidiNum < 42) { drblueskyShift1Num  = 9 ; drBSkyShift1MidiNum = 37 ;}
else if (drBSkyShift1MidiNum < 47) { drblueskyShift1Num  = 10 ; drBSkyShift1MidiNum = 42 ;}
else if (drBSkyShift1MidiNum < 51) { drblueskyShift1Num  = 11 ; drBSkyShift1MidiNum = 47 ;}
else if (drBSkyShift1MidiNum < 56) { drblueskyShift1Num  = 12 ; drBSkyShift1MidiNum = 51 ;}
else if (drBSkyShift1MidiNum < 61) { drblueskyShift1Num  = 13 ; drBSkyShift1MidiNum = 56 ;}
else if (drBSkyShift1MidiNum < 65) { drblueskyShift1Num  = 14 ; drBSkyShift1MidiNum = 61 ;}
else if (drBSkyShift1MidiNum < 70) { drblueskyShift1Num  = 15 ; drBSkyShift1MidiNum = 65 ;}
else if (drBSkyShift1MidiNum < 75) { drblueskyShift1Num  = 16 ; drBSkyShift1MidiNum = 70 ;}
else if (drBSkyShift1MidiNum < 79) { drblueskyShift1Num  = 17 ; drBSkyShift1MidiNum = 75 ;}
else if (drBSkyShift1MidiNum < 84) { drblueskyShift1Num  = 18 ; drBSkyShift1MidiNum = 79 ;}
else if (drBSkyShift1MidiNum < 89) { drblueskyShift1Num  = 19 ; drBSkyShift1MidiNum = 84 ;}
else if (drBSkyShift1MidiNum < 94) { drblueskyShift1Num  = 20 ; drBSkyShift1MidiNum = 89 ;}
else if (drBSkyShift1MidiNum < 98) { drblueskyShift1Num  = 21 ; drBSkyShift1MidiNum = 94 ;}
else if (drBSkyShift1MidiNum < 103) { drblueskyShift1Num  = 22 ; drBSkyShift1MidiNum = 98 ;}
else if (drBSkyShift1MidiNum < 108) { drblueskyShift1Num  = 23 ; drBSkyShift1MidiNum = 103 ;}
else if (drBSkyShift1MidiNum < 112) { drblueskyShift1Num  = 24; drBSkyShift1MidiNum = 108 ;}
else if (drBSkyShift1MidiNum < 117) { drblueskyShift1Num  = 25 ; drBSkyShift1MidiNum = 112 ;}
else if (drBSkyShift1MidiNum < 122) { drblueskyShift1Num  = 26; drBSkyShift1MidiNum = 117 ;}
else if (drBSkyShift1MidiNum < 127) { drblueskyShift1Num  = 27 ; drBSkyShift1MidiNum = 122 ;}
else  {drblueskyShift1Num  = 28 ;  drBSkyShift1MidiNum = 127 ;  }

drblueskyShift1Num = drblueskyShift1Num - 1 ;

//drblueskyShift1Num = lx ;

setDrShiftText();

" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/LPadMultiSlider15/setDrShift1Num" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

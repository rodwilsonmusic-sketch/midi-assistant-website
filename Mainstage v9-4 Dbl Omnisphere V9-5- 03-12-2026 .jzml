<PARAM name="x=" value="0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000,1.000000" send="17" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPn/ContainerBSkyShimmer/SwitchPreset1/x" midi_target="-1" midi_trigger="1" midi_message="0xCF,0xCF,0,78" midi_scale="0,16383" osc_scale="0.000000,1.000000" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="light=0" send="0" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPn/ContainerBSkyShimmer/SwitchPreset1/light" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="setBSkyPresets()" script="
decl lx = x;

decl lval = firstof(lx) ;


//decl val1 ; //= (1.000/30) * lcblueskyShift1Num ;

//decl val2 ; //= (1.000/29.5) * lcblueskyShift2Num;


decl shiftMidi1 = 127 ;
decl shiftMidi2 = 127 ;



//decl lcblueskyShift1Num = 28.00  ;
//decl lcblueskyShift2Num = 29.00  ;

if (lval == 0 ) {     //  + 2 Oct    + Oct
	// lcblueskyShift1Num = 28.00  ;
	// lcblueskyShift2Num = 29.00  ;

    shiftMidi1 = 127  ;
    shiftMidi2  = 117 ;

}


else if (lval == 1 ) {         //  + Oct  +10CEN 
	// lcblueskyShift1Num = 14  ;
	 // lcblueskyShift2Num = 27.5  ;
    shiftMidi1 = 117 ;
    shiftMidi2  = 63  ;
}

else if (lval == 2 )       // 3   +P5    +OCT +P5      
 {
	//lcblueskyShift1Num = 22.5  ;
	//lcblueskyShift2Num = 27.5  ;

    shiftMidi1 = 94  ;
    shiftMidi2  = 122  ;

}

else if (lval == 3 )      // 4  +M2   +P5
 {
	//lcblueskyShift1Num = 17  ;
	//lcblueskyShift2Num = 22  ;

    shiftMidi1 = 70  ;
    shiftMidi2  = 95  ;

}

else if (lval == 4 )        //5   +M2 -P4
 {
	//lcblueskyShift1Num = 18 ; // 16
	//lcblueskyShift2Num = 7  ;
    shiftMidi1 = 70  ;
    shiftMidi2  = 36  ;

}

else if (lval == 5 )      // 6   +M2   -P5
 {
	//lcblueskyShift1Num = 17  ;
	//lcblueskyShift2Num = 6  ;
    shiftMidi1 = 70  ;
    shiftMidi2  = 27  ;

}


else                    // 7      +10CEN   -OCT
 {
	//lcblueskyShift1Num = 22  ;
	//  lcblueskyShift2Num = 4  ;

    shiftMidi1 =  61 ;
    shiftMidi2  = 4  ;
}





// decl ccv1 = ((127*val1)+1) ;

//decl ccv2 = ((127*val2)+1) ;


//ctlout(0, 110, ccv1, 12) ;  //target 0, cc, value value, channel1
//ctlout(0, 111, ccv2, 12) ;  //target 0, cc, value value, channel1

Shift1.x = ((shiftMidi1+1)/127) ;
Shift2.x = ((shiftMidi2+1)/127) ;



//LPadMultiSlide25.x = ((shiftMidi1+1)/127) ; //  val1;

//LPadMultiSlide26.x = ((shiftMidi2+1)/127) ;  // val2;

/*

//BlueSkyButton1.x = 0 ;
//BlueSkyButton2.x = 0 ;

//blueskyShift1Num = lcblueskyShift1Num ;
//blueskyShift2Num = lcblueskyShift2Num ;


setShiftValText() ;
*/

/*
//setattribute(Shift1,'val',lcblueskyShift1Num);

//setattribute(Shift2,'val',lcblueskyShift2Num);


//decl ccv1 = ((127/28) * blueskyShift1Num)+1 ;

//decl ccv2 = (127/29) * blueskyShift2Num+1 ;

*/" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPn/ContainerBSkyShimmer/SwitchPreset1/setBSkyPresets" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

ContainerBlueSkyPad1.bSkyText1Num =blueskyShift1Num;
ContainerBlueSkyPad1.ContainerBSkyShimmer.setShiftValText();" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyShimmer/setBSkyShift1TextVal" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="setBSkyShift2TextVal()" script="if (BSkyShift2MidiNum < 4) { blueskyShift2Num  = 1 ;   BSkyShift2MidiNum = 0 ;}
else if (BSkyShift2MidiNum < 9) { blueskyShift2Num  = 2 ;  BSkyShift2MidiNum = 4 ;}

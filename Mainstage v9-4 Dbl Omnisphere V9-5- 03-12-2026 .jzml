<SCRIPT name="SelInfiniiteFreeze()" script="

//setbskyModeVal() ; 

decl xval = x ;
decl xsel = firstof(xval) ;

decl xmval ;

if (xsel == 0) 
{
xmval = 5 ;

}

else xmval =120 ;


ctlout(0 ,39, xmval, 6) ;  //target 0, cc, value value, channel1
" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/ContainerBSkySwell/SwitchInfFreeze2/SelInfiniiteFreeze" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

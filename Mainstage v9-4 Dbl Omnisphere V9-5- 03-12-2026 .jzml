<SCRIPT name="setbskyModeVal()" script="
decl xsel = firstof(ContainerBSkyShimmer.ModeSwitch2.x) ;




decl xmval ;

if (xsel == 0) 
{
xmval = 3 ;
bskySwitchMode1Num = xmval ;
}

else if (xsel == 1)
{

xmval = 63 ;
bskySwitchMode1Num = xmval ;
}

else 
{
xmval = 120 ;
bskySwitchMode1Num = xmval ;

}

bskyval1 = xmval;


//bskySwitchMode1Num = mval;

ctlout(0,76, xmval, 16) ;  //target 0, cc, value value, channel1" trigger_script="" trigger_type="4" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad2/ContainerBSkyChorale/setbskyModeVal" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="setShiftValText()" script="

decl shiftListLc =  {'-OCT','-M7','-m7','-M6','-m6','-P5','-TRI','-P4','-M3','-m3','-M2','-m2','-10CEN','+10CEN','+m2','+M2','+m3','+M3','+P4','+TRI','+P5','+m6','+M6','+m7','+M7','+OCT','+OCT&5','+2 OCT'};  // 29



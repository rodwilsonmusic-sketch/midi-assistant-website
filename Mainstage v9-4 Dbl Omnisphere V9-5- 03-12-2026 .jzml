<SCRIPT name="showBlueSky1Container()" script="decl ishide = x ;

if (ishide == 1) {

show(ContainerBlueSkyPn,1) ; 
//show(ContainerBlueSkyDrone1) ;
show(ContainerBlueSkyElPn,0);
CustomButtonShowBlueSkyElPiano.x = 0 ;

}
else {

show(ContainerBlueSkyPn,0) ;  // set back to 0
//show(ContainerBlueSkyDrone1,0) ;


}

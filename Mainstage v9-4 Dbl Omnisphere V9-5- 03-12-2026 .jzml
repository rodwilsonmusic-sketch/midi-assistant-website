<PARAM name="x=" value="0.000000,0.000000,1.000000,0.000000,0.000000,0.000000,0.000000" send="17" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ChorusVibratoSettingSwitch1/x" midi_target="-1" midi_trigger="1" midi_message="0xBE,0xBE,10,16" midi_scale="0,16383" osc_scale="0.000000,1.000000" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="light=0" send="0" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ChorusVibratoSettingSwitch1/light" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="setResetBar()" script="
decl notenumber = 24 ;

decl notechannel = 15 ;


//  ctlout(0, xcc, xval, 1); //target 0, cc, value value, channel1

//noteout(target,note,vel,chan) : outputs a Note On MIDI message with specified
//Target, Controller number, value and channel.

noteout(0,notenumber,127,15);

" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ChorusVibratoSettingSwitch1/setResetBar" midi_message="0x90,0x9F,0,127" midi_target="0" flag="0"/>
<SCRIPT name="setLastNotePad()" script="
decl lx = x ;
decl lval = 0 ;
decl lnoteStart = 24 ;
decl lLastNoteNum = 0 ;

lval = firstof(x) ;
lastPadVal = lval ;

if((lval+lnoteStart) != lastNoteNum)
{ 
   
   noteout(0,lastNoteNum,0,15);


   noteout(0,lnoteStart,127,15);

   noteout(0,lnoteStart,0,15);
  

   lastNoteNum = lval+lnoteStart ;

   noteout(0,lastNoteNum,127,15);

}


//If lcx== 127 and x(0) = 127
		//then lcv = 1
//elseif  lcx== 127 and x(1) = 127


" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ChorusVibratoSettingSwitch1/setLastNotePad" midi_message="0x90,0x90,0,0" midi_target="-1" flag="0"/>
<SCRIPT name="setChorusUnit()" script="
decl lx = firstof(x) ;   
//6*x ;
decl xtext = 'Vibrato' ;
decl lc = '' ;


ChorusNum = lx ;

decl xdtext = 'Chorus' ;
decl ccVal = 0;

if  (lx==0)
{
 ChorusText2 = 0 ;
 ChorusText = xdtext ;
 ccVal = 1;

} 

else if (lx==1) 
{
 ChorusText2 = 1 ;
 ChorusText = xtext ;
 ccVal = 20;
// setattribute(Text10,'Content',xtext) ;


} 

else if (lx==2) 
{
 ChorusText2 = 1 ;
 ChorusText = xdtext ;
 ccVal = 40;
// setattribute(Text10,'Content',xtext) ;

} 

else if  (lx==3)  
{
 ChorusText = xtext ;
 ChorusText2 = 2 ;
 ccVal = 60 ;
//setattribute(Text10,'Content',xtext) ;
}


else if (lx==4) 
{
 ChorusText2 =  2 ;
 ChorusText = xdtext ;
 ccVal = 80 ;
// setattribute(Text10,'Content',xtext) ;


} 

else if  (lx==5) 
{
 ChorusText2 = 3 ;
 ChorusText = xtext ;
 ccVal = 100 ;
//setattribute(Text10,'Content',xtext) ;
}

else if (lx==6) 
{
 ChorusText2 = 3 ;
 ChorusText = xdtext ;
 ccVal = 112 ;
// setattribute(Text10,'Content',xtext) ;

} 



else  
{
 ChorusText2 = 0 ;
ChorusText = xdtext ;
  ccVal = 1 ;
//setattribute(Text10,'Content',xdtext) ;
}


organChorusx = lx;

decl ccv1 = (127/6.00) * lx ; 




//organChorusx = ccv1 ;


ctlout(0, 10, ccVal, 15) ;

//ctlout(0, 110, ccv1, 12) ;  //target 0, cc, value value, channel1

//setChorusText() ;

//setattribute(Text10,'Text',ChorusText) ;

//


 

//setattribute(Text10,'content',ChorusText) ;
//setattribute(Text11,'content',ChorusText2) ;


" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ChorusVibratoSettingSwitch1/setChorusUnit" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

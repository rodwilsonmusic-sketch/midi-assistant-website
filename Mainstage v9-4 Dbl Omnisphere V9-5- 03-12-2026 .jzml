<PARAM name="x=" value="0.000000,0.000000,0.000000,0.000000,0.000000,1.000000,0.000000,0.000000,0.000000,0.000000,0.000000,0.000000" send="17" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/SwitchEffectType1/x" midi_target="-1" midi_trigger="1" midi_message="0xBF,0xBF,70,70" midi_scale="0,16383" osc_scale="0.000000,1.000000" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="light=0" send="0" osc_target="0" osc_trigger="1" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/SwitchEffectType1/light" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="setEffectType()" script="decl xeffects = x;

decl xtypeval = firstof(xeffects); 

bSkyPadEffectType1 = xtypeval ;


setBSkyEffect() ;


//ContainerBSkyChorale



if (xtypeval == 1) 
show(ContainerBSkyCloud,1);
else
show(ContainerBSkyCloud,0);


if (xtypeval == 2) 
show(ContainerBSkyChorale,1);
else
show(ContainerBSkyChorale,0);



if (xtypeval == 4) 
show(ContainerBSkyBloom,1);
else
show(ContainerBSkyBloom,0);


if (xtypeval == 5) 
show(ContainerBSkyShimmer,1);
else
show(ContainerBSkyShimmer,0);

if (xtypeval == 7) 
show(ContainerBSkySwell,1);
else
show(ContainerBSkySwell,0);
" trigger_script="x" trigger_type="0" trigger="4" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/ContainerBlueSkyPad1/SwitchEffectType1/setEffectType" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

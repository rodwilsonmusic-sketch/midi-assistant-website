else if (BSkyShift2MidiNum < 54) { blueskyShift2Num  = 12 ; BSkyShift2MidiNum = 49 ;}
else if (BSkyShift2MidiNum < 58) { blueskyShift2Num  = 13 ; BSkyShift2MidiNum = 54 ;}

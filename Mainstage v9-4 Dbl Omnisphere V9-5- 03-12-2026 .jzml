<SCRIPT name="setDrShift2Num()" script="decl lx = 29.5 *x ;

//if (lx > 21.59  & lx <22.677)   {lx = 22.67;}

//if (lx > 28.5) {lx = 29.5;}

drblueskyShift2Num = lx ;

drBSkyShift2MidiNum = round(x*127) ;

if (drBSkyShift2MidiNum < 4) { drblueskyShift2Num  = 1 ;   drBSkyShift2MidiNum = 0 ;}
else if (drBSkyShift2MidiNum < 9) { drblueskyShift2Num  = 2 ;  drBSkyShift2MidiNum = 4 ;}
else if (drBSkyShift2MidiNum < 13) { drblueskyShift2Num  = 3 ; drBSkyShift2MidiNum = 9 ;}
else if (drBSkyShift2MidiNum < 18) { drblueskyShift2Num  = 4 ; drBSkyShift2MidiNum = 13 ;}
else if (drBSkyShift2MidiNum < 22) { drblueskyShift2Num  = 5 ; drBSkyShift2MidiNum = 18 ;}
else if (drBSkyShift2MidiNum < 27) { drblueskyShift2Num  = 6 ; drBSkyShift2MidiNum = 22 ;}
else if (drBSkyShift2MidiNum < 31) { drblueskyShift2Num  = 7 ; drBSkyShift2MidiNum = 27 ;}
else if (drBSkyShift2MidiNum < 36) { drblueskyShift2Num  = 8 ; drBSkyShift2MidiNum = 31 ;}
else if (drBSkyShift2MidiNum < 40) { drblueskyShift2Num  = 9 ; drBSkyShift2MidiNum = 36 ;}
else if (drBSkyShift2MidiNum < 45) { drblueskyShift2Num  = 10 ; drBSkyShift2MidiNum = 40 ;}
else if (drBSkyShift2MidiNum < 49) { drblueskyShift2Num  = 11 ; drBSkyShift2MidiNum = 45 ;}
else if (drBSkyShift2MidiNum < 54) { drblueskyShift2Num  = 12 ; drBSkyShift2MidiNum = 49 ;}
else if (drBSkyShift2MidiNum < 58) { drblueskyShift2Num  = 13 ; drBSkyShift2MidiNum = 54 ;}
else if (drBSkyShift2MidiNum < 63) { drblueskyShift2Num  = 14 ; drBSkyShift2MidiNum = 58 ;}
else if (drBSkyShift2MidiNum < 68) { drblueskyShift2Num  = 15 ; drBSkyShift2MidiNum = 63 ;}
else if (drBSkyShift2MidiNum < 72) { drblueskyShift2Num  = 16 ; drBSkyShift2MidiNum = 68 ;}
else if (drBSkyShift2MidiNum < 77) { drblueskyShift2Num  = 17 ; drBSkyShift2MidiNum = 72 ;}
else if (drBSkyShift2MidiNum < 81) { drblueskyShift2Num  = 18 ; drBSkyShift2MidiNum = 77 ;}
else if (drBSkyShift2MidiNum < 86) { drblueskyShift2Num  = 19 ; drBSkyShift2MidiNum = 81 ;}
else if (drBSkyShift2MidiNum < 90) { drblueskyShift2Num  = 20 ; drBSkyShift2MidiNum = 86 ;}
else if (drBSkyShift2MidiNum < 95) { drblueskyShift2Num  = 21 ; drBSkyShift2MidiNum = 90 ;}
else if (drBSkyShift2MidiNum < 99) { drblueskyShift2Num  = 22 ; drBSkyShift2MidiNum = 95 ;}
else if (drBSkyShift2MidiNum < 104) { drblueskyShift2Num  = 23 ; drBSkyShift2MidiNum = 99 ;}
else if (drBSkyShift2MidiNum < 108) { drblueskyShift2Num  = 24 ; drBSkyShift2MidiNum = 104 ;}
else if (drBSkyShift2MidiNum < 113) { drblueskyShift2Num  = 25 ; drBSkyShift2MidiNum = 108 ;}
else if (drBSkyShift2MidiNum < 117) { drblueskyShift2Num  = 26 ; drBSkyShift2MidiNum = 113 ;}
else if (drBSkyShift2MidiNum < 122) { drblueskyShift2Num  = 27 ; drBSkyShift2MidiNum = 117 ;}
else if (drBSkyShift2MidiNum < 127) { drblueskyShift2Num  = 28 ; drBSkyShift2MidiNum = 122 ;}
else  {drblueskyShift2Num  = 29 ; drBSkyShift2MidiNum = 127 ;  }

drblueskyShift2Num = drblueskyShift2Num - 1 ;

//drblueskyShift1Num = lx ;


setDrShiftText();
" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/ContainerMain/ContainerMainStage2/LPadMultiSlider16/setDrShift2Num" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>
